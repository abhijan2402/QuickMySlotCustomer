require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => :static
end

target 'QuickMySlot' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  pod 'react-native-maps', :path => '../node_modules/react-native-maps', :subspecs => ['Google']
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # fmt 11.0.2's consteval path does not compile with Apple Clang from
    # Xcode 26.4+. React Native upgrades fmt in newer releases, so this can be
    # removed once the app no longer resolves fmt 11.0.2.
    fmt_base_header = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_header)
      fmt_contents = File.read(fmt_base_header)
      fmt_patched_contents = fmt_contents.sub(
        "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 1",
        "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 0"
      )
      if fmt_patched_contents != fmt_contents
        File.chmod(0644, fmt_base_header)
        File.write(fmt_base_header, fmt_patched_contents)
      end
    end
  end
end
